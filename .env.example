# Frontend variables are prefixed with VITE_ and loaded from frontend/.env.local.
VITE_API_BASE_URL=http://localhost:8000
# Official NASA Mars Trek MOLA shaded-relief tile template; override for a
# verified compatible Mars Trek service when changing the base dataset.
VITE_MARS_TILES_URL=https://trek.nasa.gov/tiles/Mars/EQ/Mars_MGS_MOLA_ClrShade_merge_global_463m/1.0.0/default/default028mm/{z}/{y}/{x}.jpg

# Backend settings (copy to .env; never commit secrets).
MARSWAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
MARSWAY_SITE_CONFIG=data/sites/jezero.json
# Optional Gemini Flash chat. Keep this key server-side; never add it to frontend/.env.local.
MARSWAY_GEMINI_API_KEY=
MARSWAY_GEMINI_MODEL=gemini-2.5-flash
MARSWAY_GEMINI_TIMEOUT_SECONDS=25
